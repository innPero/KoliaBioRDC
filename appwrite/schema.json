{
  "database": {
    "id": "kolia_db",
    "name": "Kolia Bio RDC"
  },
  "collections": [
    {
      "id": "products",
      "name": "Products",
      "documentSecurity": true,
      "permissions": ["read(\"any\")", "create(\"team:admins\")", "update(\"team:admins\")", "delete(\"team:admins\")"],
      "attributes": [
        { "key": "nom", "type": "string", "size": 100, "required": true },
        { "key": "prix", "type": "integer", "required": true },
        { "key": "unite", "type": "string", "size": 20, "required": true },
        { "key": "categorie", "type": "string", "size": 50, "required": true },
        { "key": "stock", "type": "integer", "required": true },
        { "key": "description", "type": "string", "size": 5000, "required": false },
        { "key": "image", "type": "string", "size": 255, "required": false },
        { "key": "actif", "type": "boolean", "required": true, "default": true }
      ],
      "indexes": [
        { "key": "idx_products_category", "type": "key", "attributes": ["categorie"] },
        { "key": "idx_products_active", "type": "key", "attributes": ["actif"] }
      ]
    },
    {
      "id": "orders",
      "name": "Orders",
      "documentSecurity": true,
      "permissions": ["create(\"users\")", "read(\"team:admins\")", "update(\"team:admins\")", "delete(\"team:admins\")"],
      "attributes": [
        { "key": "userId", "type": "string", "size": 50, "required": true },
        { "key": "date", "type": "datetime", "required": true },
        { "key": "client_nom", "type": "string", "size": 100, "required": true },
        { "key": "client_email", "type": "email", "required": true },
        { "key": "client_tel", "type": "string", "size": 50, "required": true },
        { "key": "point_retrait", "type": "string", "size": 120, "required": true },
        { "key": "code_retrait", "type": "string", "size": 20, "required": true },
        { "key": "note", "type": "string", "size": 500, "required": false },
        { "key": "total", "type": "integer", "required": true },
        { "key": "statut", "type": "string", "size": 30, "required": true },
        { "key": "paiement_methode", "type": "string", "size": 30, "required": true },
        { "key": "paiement_statut", "type": "string", "size": 50, "required": true },
        { "key": "paiement_operateur", "type": "string", "size": 50, "required": false },
        { "key": "paiement_numero", "type": "string", "size": 50, "required": false }
      ],
      "indexes": [
        { "key": "idx_orders_user", "type": "key", "attributes": ["userId"] },
        { "key": "idx_orders_status", "type": "key", "attributes": ["statut"] },
        { "key": "idx_orders_date", "type": "key", "attributes": ["date"] },
        { "key": "idx_orders_retrait_unique", "type": "unique", "attributes": ["code_retrait"] }
      ]
    },
    {
      "id": "order_items",
      "name": "Order Items",
      "documentSecurity": true,
      "permissions": ["create(\"team:admins\")", "read(\"team:admins\")", "update(\"team:admins\")", "delete(\"team:admins\")"],
      "attributes": [
        { "key": "order_id", "type": "string", "size": 50, "required": true },
        { "key": "product_id", "type": "string", "size": 50, "required": true },
        { "key": "nom", "type": "string", "size": 100, "required": true },
        { "key": "prix", "type": "integer", "required": true },
        { "key": "unite", "type": "string", "size": 20, "required": true },
        { "key": "quantite", "type": "integer", "required": true }
      ],
      "indexes": [
        { "key": "idx_order_items_order", "type": "key", "attributes": ["order_id"] },
        { "key": "idx_order_items_product", "type": "key", "attributes": ["product_id"] }
      ]
    },
    {
      "id": "customer_profiles",
      "name": "Customer Profiles",
      "documentSecurity": true,
      "permissions": ["create(\"users\")", "read(\"users\")", "update(\"users\")", "delete(\"team:admins\")"],
      "attributes": [
        { "key": "userId", "type": "string", "size": 50, "required": true },
        { "key": "nom", "type": "string", "size": 100, "required": true },
        { "key": "telephone", "type": "string", "size": 50, "required": false },
        { "key": "preferences", "type": "string", "size": 2000, "required": false }
      ],
      "indexes": [
        { "key": "idx_customer_user_unique", "type": "unique", "attributes": ["userId"] }
      ]
    }
  ]
}
